{
  "name": "gridiron-play-advisor-pc",
  "version": "0.1.30",
  "private": true,
  "description": "Desktop play-calling companion for Madden NFL 26 and Madden NFL 27",
  "main": "main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "npm run verify:pc",
    "start": "npm run check:core && powershell -Command \"Remove-Item Env:ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; electron .\"",
    "dist": "npm run prepare:dist && electron-builder --win nsis",
    "check:core": "node ./scripts/check-pc-core.mjs",
    "test:regression": "node --test ./scripts/test-app-regressions.cjs",
    "test:gameplan": "node --test ./shared/test/*.test.js",
    "verify:pc": "npm run check:core && npm run test:gameplan && npm run test:regression",
    "prepare:dist": "npm run verify:pc"
  },
  "build": {
    "appId": "com.gridiron.playadvisor.pc",
    "productName": "Gridiron Play Advisor",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "app.js",
      "shared/**",
      "data/**",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "assets/**"
    ],
    "asarUnpack": [],
    "extraFiles": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "extraResources": [],
    "afterPack": "./scripts/after-pack-win-icon.mjs",
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12"
  }
}
